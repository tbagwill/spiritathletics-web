# Copy to .env.staging.local (git-ignored) and fill in as you go through docs/staging-setup.md.
# One value per line, no quotes, no spaces around "=".

# Step 1 · Neon → Branches → staging → Connect → pooled connection string
STAGING_DATABASE_URL=

# Leave as-is unless the staging address changes
STAGING_SITE_URL=https://staging.spiritathletics.net

# Step 2 · offered as the default email for your staging admin login
STAGING_ADMIN_EMAIL=

# Step 2 · where staging shop/booking staff alerts go (your email, not the front desk)
STAGING_ALERT_EMAIL=

# Step 4 · Vercel → Settings → Deployment Protection → Protection Bypass for Automation
STAGING_BYPASS_SECRET=

# Step 5 · Stripe (test mode) → your staging webhook → Signing secret (starts with whsec_)
STAGING_WEBHOOK_SECRET=

# STAGING_NEXTAUTH_SECRET and STAGING_VERCEL_READY are added for you by the scripts.
